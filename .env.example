# Optional public business details. Copy to /etc/iqland.env on the VPS.
# systemd reads this file after installing the updated deploy/iqland.service.
# Fill with verified real details; empty values are not displayed.
IQLAND_LEGAL_NAME=""
IQLAND_LEGAL_ID=""
IQLAND_LEGAL_ADDRESS=""
IQLAND_PRIVACY_EMAIL=""
# Verify the physical location of the primary database and backups separately.
# This label DOES NOT move or restrict the database.
IQLAND_STORAGE_COUNTRY=""
# Keep new applications paused during relocation and legal setup.
# Set false only after verifying the actual processing arrangements.
IQLAND_REGISTRATION_PAUSED="true"
