{
  "name": "iq-land",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "privacy": "node server/privacy-cli.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && node tests/browser.mjs",
    "test:registration": "npm run build && node tests/registration-browser.mjs",
    "test:worldwide": "npm run build && node tests/worldwide-browser.mjs",
    "test:archive": "npm run build && node tests/archive-browser.mjs",
    "test:awards": "npm run build && node tests/awards-browser.mjs",
    "test:launch": "npm run build && node tests/launch-browser.mjs",
    "test:i18n": "npm run build && node tests/i18n-browser.mjs",
    "test:documents": "npm run build && node tests/documents-browser.mjs",
    "test:privacy": "npm run build && node tests/privacy-browser.mjs",
    "test:bulk-registration": "npm run build && node tests/bulk-registration-browser.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "maxmind": "5.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
